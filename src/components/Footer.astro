---
import { Icon } from 'astro-icon/components';
import MLink from './MLink.vue';
import Social from './Social.astro';

const year = new Date().getFullYear();
---

<footer
  class="bg-neutral-50 dark:bg-neutral-800 border-primary-600 dark:border-neutral-700 border-b-8"
>
  <div class="wrapper mx-auto mt-24 px-5">
    <div class="md:py-5">
      <div
        class="mt-6 flex flex-col items-center justify-between md:mt-0 md:flex-row"
      >
        <div class="logo flex items-center">
          <div
            class="text-neutral-700 dark:text-neutral-200 mx-1 mt-5 text-center text-sm sm:mt-0 sm:text-left"
          >
            <p class="font-bold">© {year} Michael Thomas</p>
            <p>
              Built with{' '}
              <Icon
                name="noto:red-heart"
                class="inline"
              />{' '}
              and{' '}
              <MLink
                aria-label="michaelt.xyz"
                blank
                class="text-neutral-700 dark:text-neutral-200 text-sm gradient-link"
                href="https://github.com/michaelhthomas/michaelhthomas.github.io"
                >available on GitHub</MLink
              >
            </p>
          </div>
        </div>

        <div>
          <Social />
        </div>
      </div>
    </div>
  </div>
</footer>
