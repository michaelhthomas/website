---
interface Props {
  tags: string[];
  variant?: 'post' | 'tag';
  class?: string;
}

const { tags, variant = 'tag', class: className, ...rest } = Astro.props;
---

<div
  class:list={['post-tags', className]}
  {...rest}
>
  {
    tags.map((tag) => (
      <a
        class={
          variant === 'post'
            ? 'text-primary-600 hover:text-primary-500 dark:text-primary-400 dark:hover:text-primary-500 mr-2 rounded text-sm font-semibold uppercase tracking-wide transition-colors'
            : 'text-neutral-600 dark:text-neutral-300 bg-neutral-400/25 dark:bg-neutral-600/40 mr-1 rounded px-2 py-1 text-sm font-semibold'
        }
        href={`/tag/${tag}`}
      >
        {' '}
        <span>#</span> {tag}{' '}
      </a>
    ))
  }
</div>
