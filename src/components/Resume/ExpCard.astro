---
import MLink from '../MLink.vue';

interface Props {
  title: string;
  subtitle: string;
  link: string;
  years: string;
}

let { title, subtitle, link, years } = Astro.props;
---

<div class="my-4 space-y-0.5">
  <div class="flex items-center justify-between space-x-2">
    <h3 class="text-neutral-800 dark:text-neutral-200 text-xl font-semibold">
      <MLink
        href={link}
        blank
        class="hover:underline"
      >
        {title}
      </MLink>
    </h3>

    <span class="text-neutral-600 dark:text-neutral-400 text-lg font-medium"
      >{years}</span
    >
  </div>

  <p class="text-neutral-600 dark:text-neutral-400 text-lg">
    {subtitle}
  </p>
</div>
